---
interface Props {
  results: readonly { value: string; label: string }[];
}

const { results } = Astro.props;
---

<dl class="results">
  {results.map((result) => (
    <div>
      <dt>{result.label}</dt>
      <dd>{result.value}</dd>
    </div>
  ))}
</dl>

<style>
  .results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: 1.5rem 2rem;
  }

  .results div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
  }

  dd {
    color: var(--ink);
    font-size: var(--step-3);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  dt {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
