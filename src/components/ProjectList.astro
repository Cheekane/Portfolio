---
import { Picture } from 'astro:assets';
import { workImage, workPath } from '../lib/work';
import type { Project } from '../content/schema';

interface Props {
  projects: readonly Project[];
}

const { projects } = Astro.props;
---

<ul class="projects" data-testid="project-list">
  {projects.map((project) => (
    <li data-id={project.id}>
      <a class="shot" href={workPath(project.id)} tabindex="-1" aria-hidden="true">
        <Picture
          src={workImage(project.cover.file)}
          alt=""
          formats={['avif', 'webp']}
          widths={[400, 640, 960, 1280]}
          sizes="(min-width: 56rem) 26rem, (min-width: 40rem) 45vw, 92vw"
        />
      </a>
      <div class="text">
        <p class="muted years">{project.years}</p>
        <h3>
          <a href={workPath(project.id)}>{project.name}</a>
        </h3>
        <p class="summary">{project.summary}</p>
        <ul class="tags" aria-label="Built with">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <p class="more">
          <a class="arrow-link" href={workPath(project.id)}>
            View project<span class="visually-hidden">: {project.name}</span>
            <span class="arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        </p>
      </div>
    </li>
  ))}
</ul>

<style>
  .projects {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  .projects > li {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  .shot {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: 0 0 0 1px var(--ring);
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .projects > li:hover .shot :global(img) {
    transform: scale(1.02);
  }

  .years {
    font-size: 0.875rem;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  h3 a {
    color: var(--ink);
    font-weight: inherit;
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .more {
    margin-top: 1rem;
  }

  .summary {
    margin-block: 0.5rem 1rem;
    max-width: 34rem;
  }

  @media (min-width: 40rem) {
    .projects > li {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 2rem;
    }
  }
</style>
