---
import Results from './Results.astro';
import { formatRange } from '../lib/dates';
import { joinFacts } from '../lib/text';
import { workPath } from '../lib/work';
import type { Experience } from '../content/schema';

interface Props {
  entry: Experience;
}

const { entry } = Astro.props;
const meta = [entry.role, formatRange(entry.start, entry.end), entry.location];
const results = entry.detail?.results.slice(0, 4) ?? [];
---

<section class="wrap" aria-labelledby="lead-title" data-testid="lead" data-lead-id={entry.id}>
  <div class="lead card">
    <p class="eyebrow">{entry.end ? 'Most recent' : 'Now'}</p>
    <h2 id="lead-title">{entry.company}</h2>
    <p class="meta">{joinFacts(meta)}</p>
    {entry.summary && <p class="summary">{entry.summary}</p>}
    {results.length > 0 && (
      <div class="stats">
        <Results results={results} />
      </div>
    )}
    {entry.detail && (
      <p>
        <a class="button" href={workPath(entry.id)}>
          See what I built at {entry.company}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </p>
    )}
  </div>
</section>

<style>
  .lead {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  h2 {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .meta {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .summary {
    font-size: var(--step-2);
    line-height: 1.6;
    max-width: 42rem;
  }

  .stats {
    margin-block: 1rem 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
  }
</style>
