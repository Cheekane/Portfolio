---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import LeadFeature from '../components/LeadFeature.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ProjectList from '../components/ProjectList.astro';
import { profile } from '../data/profile';
import { formatRange } from '../lib/dates';
import { leadOf } from '../lib/order';
import { getExperience, getProjects } from '../lib/work';

const experience = await getExperience();
const projects = await getProjects();
const lead = leadOf(experience);
const { education } = profile;
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="eyebrow kicker rise">
      <span>{profile.title}</span>
      <span>{profile.location}</span>
    </p>
    <h1 id="hero-title" class="rise" style="--i: 1">
      {profile.name}
    </h1>
    <p class="tagline rise" style="--i: 2">
      {profile.tagline}
    </p>
    <ul class="links rise" style="--i: 3">
      <li>
        <a class="button" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </li>
      <li>
        <a class="button secondary" href="#resume">
          Resume
        </a>
      </li>
      <li>
        <a class="text" href={profile.links.linkedin} rel="noopener">
          LinkedIn
        </a>
      </li>
      <li>
        <a class="text" href={profile.links.github} rel="noopener">
          GitHub
        </a>
      </li>
    </ul>
  </section>

  {lead && <LeadFeature entry={lead} />}

  <Section id="experience" title="Experience">
    <ExperienceList entries={experience} />
  </Section>

  <Section id="projects" title="Projects">
    <ProjectList projects={projects} />
  </Section>

  <Section id="skills" title="Skills">
    <dl class="skills">
      {profile.skills.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="education" title="Education">
    <div class="education">
      <h3>{education.school}</h3>
      <p>{education.degree}</p>
      <p class="muted">{formatRange(education.start, education.end)}</p>
      <ul>
        {education.honours.map((honour) => (
          <li>{honour}</li>
        ))}
      </ul>
    </div>
  </Section>

  <Section id="about" title="About">
    <div class="about">
      {profile.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </Section>

  <Section id="resume" title="Resume">
    <div class="resume">
      <p>
        <a class="button secondary" href={profile.resume.view} rel="noopener">
          Open the resume in Google Drive
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </p>
      <iframe
        class="card"
        src={profile.resume.preview}
        title={`Preview of ${profile.name}'s resume`}
        loading="lazy"
        referrerpolicy="no-referrer"
        allow="autoplay"
      ></iframe>
    </div>
  </Section>

  <Section id="contact" title="Contact">
    <ul class="contact">
      <li>
        <a class="button" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </li>
      <li>
        <a class="button secondary" href={profile.links.linkedin} rel="noopener">
          LinkedIn{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </li>
      <li>
        <a class="button secondary" href={profile.links.github} rel="noopener">
          GitHub{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </li>
    </ul>
  </Section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5rem);
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
  }

  /* The place sits beside the title in a quieter grey. */
  .kicker span + span {
    color: var(--muted);
    font-weight: 500;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    margin-left: -0.04em;
  }

  .tagline {
    font-size: var(--step-2);
    line-height: 1.6;
    max-width: 38rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .links .text {
    padding-inline: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  .links .text:hover {
    color: var(--accent);
  }

  .skills {
    display: grid;
    gap: 1.5rem;
  }

  .skills div {
    display: grid;
    gap: 0.25rem;
  }

  .skills dt {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 2;
    color: var(--ink);
  }

  .skills dd {
    max-width: 42rem;
  }

  .education {
    display: grid;
    gap: 0.125rem;
  }

  .education h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
  }

  .education .muted {
    font-size: 0.875rem;
  }

  .education ul {
    margin-top: 0.75rem;
  }

  .about {
    display: grid;
    gap: 1.125rem;
    max-width: 40rem;
  }

  .resume {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  iframe {
    display: block;
    width: 100%;
    max-width: 46rem;
    aspect-ratio: 8.5 / 11;
    border: 0;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .skills div {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
